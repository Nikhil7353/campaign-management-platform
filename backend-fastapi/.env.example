APP_NAME=Communication Desk
APP_ENV=development
DATABASE_URL=sqlite:///./storage/database.sqlite
FRONTEND_ORIGIN=http://localhost:5173

# Email delivery and inbox synchronization
AUTOMATIC_SENDING_ENABLED=true
MAIL_DRY_RUN=true
# Brevo transactional SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Communication Desk
# Optional inbound mailbox (Gmail/Outlook IMAP, if inbox sync is needed)
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
INBOX_AUTO_SYNC_ENABLED=false
INBOX_AUTO_SYNC_INTERVAL_SECONDS=300

# Meta WhatsApp Cloud API
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Legacy gateway fields are optional and no longer used by default.
WHATSAPP_BASE_URL=

# Google Sheets OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

